{
  "manifest_version": 3,
  "name": "SCREAM SCROLL",
  "version": "1.0",
  "description": "Your voice is now your mouse. Scream to scroll.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
